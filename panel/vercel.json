{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "mkdir -p public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/proxy?path=" },
    { "source": "/:path*", "destination": "/api/proxy?path=:path*" }
  ]
}
