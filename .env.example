# ===== База данных (общая Postgres; агент создаёт только таблицы agent_*) =====
DATABASE_URL="postgresql://user:pass@host:5432/db"

# ===== Telegram (управление и уведомления) =====
# Рекомендуется СВЕЖИЙ токен от BotFather (старый afisha-деплой не должен держать этот же токен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ===== Режим агента =====
# sim  — симулятор (без внешних счетов, случайное блуждание с реалистичным спредом)
# live — торговля через OANDA API (какой счёт — решает OANDA_ENV ниже)
AGENT_MODE=sim
SYMBOL=EUR_USD
SIM_START_BALANCE=50

# ===== OANDA v20 (для AGENT_MODE=live) =====
# practice — демо-счёт (бесплатно, тот же API); live — реальные деньги ($10–50 для теста)
OANDA_ENV=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# ===== Мини-PWA админка =====
ADMIN_PASSWORD=
# Секрет подписи сессионной cookie (любая длинная случайная строка; если пусто — генерируется на старте)
SESSION_SECRET=
# VAPID-ключи Web Push (если пусто — сгенерируются в data/vapid.json автоматически)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Отчёты =====
# Окно ежечасной сводки в минутах (30–60 по задумке)
REPORT_WINDOW_MIN=60

# ===== Обучение (опционально) =====
# 1 = еженедельный авто-ребэктест с предложением параметров (требует диска/CPU — на Render лучше выключить)
AUTO_RETRAIN=0
# Ежедневный LLM-разбор журнала сделок (нужен ключ OpenAI; пусто = выключено)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Прочее =====
PORT=3000
