# ===== База данных =====
# Схема fxagent в Supabase-проекте Kiddeo уже создана (миграция fx_agent_init).
# Строку брать из Supabase → Connect → Session pooler (direct — IPv6-only, Render не умеет)
# и ОБЯЗАТЕЛЬНО добавить ?schema=fxagent
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?schema=fxagent"

# ===== Telegram (управление и уведомления) =====
# Рекомендуется СВЕЖИЙ токен от BotFather (старый afisha-деплой не должен держать этот же токен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ===== Режим агента =====
# sim  — симулятор (без внешних счетов, случайное блуждание с реалистичным спредом)
# live — торговля через OANDA API (какой счёт — решает OANDA_ENV ниже)
AGENT_MODE=sim
SYMBOL=EUR_USD
SIM_START_BALANCE=50

# ===== Live-брокер (для AGENT_MODE=live): oanda | metaapi =====
BROKER=metaapi

# --- Вариант A: MT5 через MetaApi.cloud (Exness demo — без KYC, из любой страны) ---
# metaapi.cloud → API token; там же добавить MT5-аккаунт (логин/пароль/сервер от брокера) → accountId
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Точное имя символа из терминала: у Exness Standard — EURUSDm
MT5_SYMBOL=EURUSDm

# --- Крипто-эксперимент выходных (только live+metaapi) ---
# 1 = пока FX закрыт (пт 20:45 → вс 21:15 UTC), торгуется крипто-CFD на том же счёте.
# ЧЕСТНО: преимущество бэктестом НЕ подтверждено (docs/CRYPTO-SWEEP-2026-07-31.md) —
# это сбор форвард-данных на демо минимальным объёмом. Свой дневной лимит убытка,
# при срабатывании — пауза до следующего дня (основной FX-контур не останавливается).
CRYPTO_WEEKEND=0
# btc = BTCUSDm, echo/limit (лучшая выходная ячейка sweep; train-выходные красные)
# eth = ETHUSDm, momentum/limit (единственная ячейка, зелёная на train и test)
CRYPTO_PRESET=btc
# Переопределить имя символа, если у брокера оно другое (дефолт из пресета)
MT5_SYMBOL_CRYPTO=

# --- Мейкер-эксперимент на Binance Futures TESTNET (фейковые деньги) ---
# 1 = post-only страддл на BTCUSDT-перпетуале тестнета: пассивная сторона платит
# известную комиссию мейкера вместо спреда. Регистрация: testnet.binancefuture.com
# (отдельный аккаунт, без KYC), ключи — вкладка «API Key» под графиком.
# Работает в любом режиме агента (sim/live) — денег там нет. Свой дневной лимит.
MAKER_TESTNET=0
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_SYMBOL=BTCUSDT

# --- Вариант B: OANDA v20 (нужно резидентство обслуживаемой страны) ---
# practice — демо-счёт (тот же API); live — реальные деньги
OANDA_ENV=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# ===== Мини-PWA админка =====
ADMIN_PASSWORD=
# Секрет подписи сессионной cookie (любая длинная случайная строка; если пусто — генерируется на старте)
SESSION_SECRET=
# VAPID-ключи Web Push (если пусто — сгенерируются в data/vapid.json автоматически)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Ансамбль виртуальных стратегий =====
# Включён по умолчанию (в live-режиме): 5 стратегий торгуют ВИРТУАЛЬНО на живых
# котировках (mode=virtual в БД), лицензии справочные, денег не касается.
# 0 = выключить
ENSEMBLE=1

# Мультирыночная виртуальная нога: победители свипа 01.08 (золото, нефть,
# GBPJPY, S&P500) на том же MT5-счёте, тоже виртуально. 0 = выключить
MARKETS=1

# ===== Отчёты =====
# Окно ежечасной сводки в минутах (30–60 по задумке)
REPORT_WINDOW_MIN=60

# ===== Обучение (опционально) =====
# 1 = еженедельный авто-ребэктест с предложением параметров (требует диска/CPU — на Render лучше выключить)
AUTO_RETRAIN=0
# Ежедневный LLM-разбор журнала сделок (нужен ключ OpenAI; пусто = выключено)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Прочее =====
PORT=3000
