{
  "name": "fx-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Тестовый FX авто-агент: EUR/USD micro, sim/OANDA, Telegram + мини-PWA админка",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "db:push": "prisma db push",
    "backtest": "tsx src/backtest/runner.ts",
    "backtest:data": "tsx src/backtest/data.ts",
    "sweep": "tsx src/backtest/sweep.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/web-push": "^3.6.3",
    "dotenv": "^17.2.3",
    "dukascopy-node": "^1.50.0",
    "express": "^4.19.2",
    "prisma": "^5.19.0",
    "telegraf": "^4.16.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "undici": "^6.19.0",
    "uplot": "^1.6.30",
    "web-push": "^3.6.7"
  }
}