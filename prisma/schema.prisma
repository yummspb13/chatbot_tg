// FX-агент: все таблицы с префиксом agent_ — БД общая с другим приложением,
// таблицы afisha_bot_* этой схемой не описываются и не трогаются.
// Применение схемы: ТОЛЬКО `npx prisma db push` вручную (не в билде деплоя).
// `prisma migrate` / `migrate reset` на этой общей БД запрещены.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentSettings {
  id           Int       @id @default(1)
  mode         String    @default("sim") // "sim" | "live"
  symbol       String    @default("EUR_USD")
  isRunning    Boolean   @default(false)
  params       Json      @default("{}")
  killSwitchAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("agent_Settings")
}

model Trade {
  id             Int       @id @default(autoincrement())
  mode           String // "sim" | "live"
  symbol         String
  side           String // "BUY" | "SELL"
  units          Int
  entryPrice     Float
  exitPrice      Float?
  slPrice        Float?
  tpPrice        Float?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  pnl            Float?
  costSpread     Float?
  costCommission Float?    @default(0)
  brokerTradeId  String?
  closeReason    String? // TP | SL | MANUAL | KILL | RECONCILED
  // контекст входа («память» агента)
  spreadAtEntry  Float?
  volAtEntry     Float?
  hourUtc        Int?
  newsDistMin    Int?
  paramsSnapshot Json?

  @@index([openedAt])
  @@index([mode, closedAt])
  @@map("agent_Trade")
}

model EquitySnapshot {
  id            Int      @id @default(autoincrement())
  ts            DateTime @default(now())
  mode          String
  balance       Float
  equity        Float
  openPositions Int

  @@index([ts])
  @@map("agent_EquitySnapshot")
}

model ParamProposal {
  id             Int      @id @default(autoincrement())
  params         Json
  backtestReport Json
  status         String   @default("pending") // pending | applied | rejected
  createdAt      DateTime @default(now())

  @@map("agent_ParamProposal")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("agent_PushSubscription")
}

// --- Polymarket-подсистема (docs/POLYMARKET-PLAN-2026-08-17.md) ---
// DDL накатывается синхронно через Supabase apply_migration (db push не нужен)

model PolySnap {
  id        Int      @id @default(autoincrement())
  ts        DateTime @default(now())
  asset     String
  slug      String
  endDate   DateTime
  upBid     Float?
  upAsk     Float?
  downBid   Float?
  downAsk   Float?
  setSumAsk Float?
  depthUsd  Float?
  refPx     Float?
  isEvent   Boolean  @default(false)

  @@index([ts])
  @@index([asset, ts])
  @@index([slug])
  @@map("poly_Snap")
}

model PolyResolution {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  asset        String
  endTs        DateTime
  outcome      String
  closeUpPrice Float?
  twapNote     String?
  createdAt    DateTime @default(now())

  @@index([asset, endTs])
  @@map("poly_Resolution")
}
